# 复制成 server/.env 后按需修改。.env 不要提交到仓库。

APP_ENV=dev

# 生产必须换掉：这个值一变，所有已签发的 token 立即失效
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# 开发默认 SQLite，生产按 PRD 用 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://fitmeal:password@localhost:5432/fitmeal
# DATABASE_URL=sqlite+aiosqlite:///./var/fitmeal.db
SQL_ECHO=false

# 照片存储与保留期限（PRD N-9）
STORAGE_DIR=./var/photos
PHOTO_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=5242880

# 识别 Provider：mock = 本地假识别；openai = 任意 OpenAI 兼容的多模态接口
RECOGNIZER_PROVIDER=mock
RECOGNITION_TIMEOUT_SECONDS=15
DAILY_RECOGNITION_LIMIT=20
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
