# docker compose 用的变量，复制成同目录下的 .env 后按需修改：
#   cp .env.docker.example .env
#
# 这份和 server/.env 是两回事——这份只喂给 docker-compose.yml 做变量替换，
# server/.env 是本机直接跑 uvicorn（不走 Docker）时用的，两边不共享。

POSTGRES_USER=fitmeal
POSTGRES_PASSWORD=fitmeal
POSTGRES_DB=fitmeal

# 生产必须换掉：这个值一变，所有已签发的 token 立即失效。
SECRET_KEY=please-change-this-secret-key

# mock = 本地假识别，不需要 Key；openai = 任意 OpenAI 兼容的多模态接口。
RECOGNIZER_PROVIDER=mock
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 只有浏览器场景（Flutter Web / 后台管理页）才需要，原生 App 不受 CORS 限制。
# 部署到 https://easycodetech.top 后建议收窄，别一直用 *：
# CORS_ORIGINS=["https://easycodetech.top"]
CORS_ORIGINS=["*"]
